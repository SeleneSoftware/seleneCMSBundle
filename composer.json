{
    "name": "selenesoftware/cms-bundle",
    "type": "symfony-bundle",
    "version": "0.1.0",
    "description": "CMS platform for Symfony",
    "homepage": "https://github.com/SeleneSoftware/seleneCMSBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jason Marshall - JasonMarshallSelene@gmail.com",
            "homepage": "https://github.com/SeleneSoftware"
        }
    ],
    "require": {
        "php": "^8.1|^8.2",
        "twig/extra-bundle": "^3.4",
        "twig/markdown-extra": "^3.4",
        "twig/twig": "^3.11",
        "symfony/security-bundle": "^7.0|^7.1",
        "symfony/security-csrf":"^7.0|^7.1",
        "symfony/form": "^7.0|^7.1",
        "symfony/mime": "^7.0|^7.1",
        "league/commonmark": "^2.3",
        "presta/sitemap-bundle": "^4.0",
        "symfony/orm-pack": "^2.3",
        "symfonycasts/reset-password-bundle": "^1.22",
        "symfony/ux-turbo": "^2.21",
        "symfony/ux-twig-component": "^2.21",
        "symfony/ux-toggle-password": "^2.21",
        "eckinox/tinymce-bundle": "^1.1",
        "symfony/expression-language": "^7.0|^7.1",
        "symfony/mailer": "^7.0|^7.1",
        "respect/validation": "^2.3",

                "doctrine/dbal": "^3",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.3",
    },
    "autoload": {
        "psr-4": {
            "Selene\\CMSBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Selene\\CMSBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
